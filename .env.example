# ---- Parkage configuration (all optional) ----

# Leave both empty to create the owner account in the browser (setup wizard).
# If set, these also work as the root S3 access key / secret key (MinIO compatible).
PARKAGE_ROOT_USER=
PARKAGE_ROOT_PASSWORD=

# Host ports and data location
PARKAGE_S3_PORT=9000
PARKAGE_CONSOLE_PORT=9001
PARKAGE_DATA_PATH=./data

# Region reported to S3 clients
PARKAGE_REGION=us-east-1

# Public URLs when running behind a reverse proxy (used for share links & UI hints)
# PARKAGE_S3_PUBLIC_URL=https://s3.example.com
# PARKAGE_CONSOLE_PUBLIC_URL=https://storage.example.com
# Virtual-host style buckets (bucket.s3.example.com)
# PARKAGE_DOMAIN=s3.example.com

# Prometheus: scrape http://host:9000/metrics with "Authorization: Bearer <token>"
# PARKAGE_METRICS_TOKEN=change-me

# Optional 32+ byte base64 master key (otherwise generated in /data/.parkage.sys/iam/master.key)
# PARKAGE_MASTER_KEY=

# How often storage usage is recalculated, console session length
PARKAGE_SCAN_INTERVAL=5m
PARKAGE_SESSION_TTL=12h

# Check GitHub releases for new versions (shown in Settings)
PARKAGE_UPDATE_CHECK=true
PARKAGE_LOG_JSON=false
